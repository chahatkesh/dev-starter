# Dev Starter runtime contract

# production, development, or test. Staging is intentionally not supported.
APP_ENV=development
NEXT_PUBLIC_APP_NAME="Dev Starter"

# Required for signed login sessions.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Seeded admin account for local development and deploy-time db:seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Required only when a feature needs persistence.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_starter_dev

# Local Docker database defaults. Production values are provided by the runtime.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dev_starter_dev
POSTGRES_PORT=5432
